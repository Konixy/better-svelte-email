{
	"name": "better-svelte-email-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.3",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --cwd apps/docs dev",
		"build": "turbo run build",
		"test": "turbo run test",
		"lint": "turbo run lint",
		"check": "turbo run check",
		"package": "turbo run package",
		"format": "prettier --write .",
		"ci:version": "changeset version",
		"ci:publish": "bash ./scripts/ci-publish.sh"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.0",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "24.10.9",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.23",
		"shiki": "^4.4.3",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"svelte-themes": "^2.0.10",
		"tsdown": "^0.22.14",
		"turbo": "^2.10.9",
		"typescript": "6",
		"typescript-eslint": "^8.67.0",
		"unrun": "^0.3.1",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	}
}
