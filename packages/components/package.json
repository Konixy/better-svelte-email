{
	"name": "@better-svelte-email/components",
	"version": "2.4.0",
	"description": "Email components for better-svelte-email",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Konixy/better-svelte-email.git",
		"directory": "packages/components"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"import": "./dist/utils/index.js",
			"default": "./dist/utils/index.js"
		},
		"./*.svelte": {
			"types": "./dist/components/*.svelte.d.ts",
			"svelte": "./dist/components/*.svelte"
		},
		"./package.json": "./package.json"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/__tests__",
		"!dist/emails"
	],
	"scripts": {
		"build": "svelte-package -i src && publint",
		"lint": "bun fmt --check --ignore-path ../../.prettierignore && eslint src --max-warnings 0",
		"test": "vitest run"
	},
	"devDependencies": {
		"@better-svelte-email/server": "workspace:*"
	},
	"peerDependencies": {
		"@sveltejs/kit": ">=2",
		"svelte": ">=5.14.3"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		}
	}
}
