{
	"name": "@better-svelte-email/preview-server",
	"version": "2.3.1",
	"description": "Internal preview runtime for @better-svelte-email/cli",
	"type": "module",
	"main": "./build/index.js",
	"files": [
		"build"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./build/index.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "bunx --bun vite build",
		"build:watch": "vite build --watch",
		"start": "node build",
		"test": "vitest run"
	},
	"author": "Konixy",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Konixy/better-svelte-email.git",
		"directory": "packages/preview-server"
	},
	"dependencies": {
		"@lucide/svelte": "^1.61.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@tailwindcss/vite": "^4.3.3",
		"clsx": "^2.1.1",
		"runed": "^0.37.1",
		"shiki": "^4.5.0",
		"svelte-themes": "^2.0.10",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"vite": "^8.3.5"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"bits-ui": "^2.20.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
