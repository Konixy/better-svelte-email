		"mdsvex": "^0.12.8",
		"mode-watcher": "^1.1.0",
		"phosphor-svelte": "^3.1.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"resend": "^6.19.0",
		"shiki": "^4.4.3",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tailwindcss-motion": "^1.1.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
