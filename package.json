{
	"name": "better-svelte-email-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.3",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --cwd apps/docs dev",
		"build": "turbo run build",
		"test": "turbo run test",
		"lint": "turbo run lint",
		"check": "turbo run check",
		"package": "turbo run package",
		"format": "prettier --write .",
		"ci:version": "changeset version",
		"ci:publish": "bash ./scripts/ci-publish.sh"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "26.6.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.25",
		"shiki": "^4.5.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-themes": "^2.0.10",
		"tsdown": "^0.23.1",
		"turbo": "^2.11.10",
		"typescript": "6",
		"typescript-eslint": "^8.72.0",
		"unrun": "^0.3.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
