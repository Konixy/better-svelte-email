{
	"name": "better-svelte-email-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"check": "turbo run check",
		"ci:publish": "bash ./scripts/ci-publish.sh",
		"ci:version": "changeset version",
		"dev": "bun run --cwd apps/docs dev",
		"format": "bun fmt",
		"lint": "turbo run lint",
		"package": "turbo run package",
		"test": "turbo run test"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/compat": "^2.1.1",
		"@eslint/config-helpers": "^0.7.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "26.6.6",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-packagejson": "^3.1.0",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.25",
		"shiki": "^4.6.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-themes": "^2.0.10",
		"tsdown": "^0.23.7",
		"turbo": "^2.11.11",
		"typescript": "7",
		"typescript-eslint": "^8.73.0",
		"unrun": "^0.3.1",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"packageManager": "bun@1.4.4"
}
