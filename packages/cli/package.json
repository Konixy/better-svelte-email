{
	"name": "@better-svelte-email/cli",
	"version": "2.4.0",
	"description": "CLI for better-svelte-email",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Konixy/better-svelte-email.git",
		"directory": "packages/cli"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"bin": {
		"bse": "./dist/index.cjs"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bun run build:cli",
		"build:cli": "tsdown",
		"dev": "bun --watch src/index.ts dev --preview-dev --preview-port 3001 -d ../../apps/docs/src/lib/emails -c ../../apps/docs/src/app.css",
		"lint": "bun fmt --check --ignore-path ../../.prettierignore && eslint src --max-warnings 0",
		"test": "vitest run"
	},
	"dependencies": {
		"@better-svelte-email/preview-server": "workspace:*",
		"@better-svelte-email/server": "workspace:*",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"chokidar": "^6.0.0",
		"commander": "^15.0.0",
		"prettier": "^3.9.10",
		"resend": "^6.34.1",
		"svelte": "^5.57.2",
		"vite": "^8.3.5"
	},
	"publishConfig": {
		"access": "public"
	}
}
