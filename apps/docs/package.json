{
	"name": "docs",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"lint": "bun fmt --check --ignore-path ../../.prettierignore && eslint src --max-warnings 0",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "vite preview",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@better-svelte-email/components": "workspace:*",
		"@better-svelte-email/preview": "workspace:*",
		"@better-svelte-email/server": "workspace:*",
		"clsx": "^2.1.1",
		"mdsvex": "^1.0.0",
		"mode-watcher": "^1.1.0",
		"phosphor-svelte": "^3.1.1",
		"resend": "^6.34.1",
		"shiki": "^4.5.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tailwindcss-motion": "^1.1.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "26.6.11",
		"bits-ui": "^2.20.0",
		"prettier": "^3.9.10",
		"svelte": "^5.57.2",
		"tailwind-variants": "^4.0.0",
		"vite": "^8.3.5",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.0.5"
	}
}
